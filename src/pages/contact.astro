---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteInfo } from '../data/siteInfo';
---

<BaseLayout title="Hubungi Kami | PT. Bintang Surya Teknik Persada" activeNav="contact">
    <!-- Header Halaman -->
    <section class="page-header">
        <div class="page-header-bg-overlay"></div>
        <div class="container">
            <h1 class="page-header-title">Hubungi Kami</h1>
            <p class="page-header-subtitle">Hubungi sales engineer kami via email, telepon, atau WhatsApp dan dapatkan penawaran harga resmi (Quotation) dalam 1x24 jam kerja.</p>
        </div>
    </section>

    <!-- Konten Kontak Utama -->
    <section class="contact" id="contact">
        <div class="container">
            <div class="contact-grid" style="display: flex; justify-content: center;">
                
                <div class="contact-info-panel" style="max-width: 600px; width: 100%;">
                    <h3 style="font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">PT. BINTANG SURYA TEKNIK PERSADA</h3>
                    <p class="panel-desc"></p>
                    
                    <div class="contact-methods">
                        <div class="method-item">
                            <div class="method-icon"><i class="fa-solid fa-map-location-dot"></i></div>
                            <div class="method-text">
                                <h4 style="font-weight: 800;">Alamat Kantor</h4>
                                <p style="color: #ffffff;">Jl. Abdurahman No.165, RW.8, Parigi Baru, Kec. Pd. Aren, Kota Tangerang Selatan, Banten 15228</p>
                            </div>
                        </div>
                        
                        <div class="method-item">
                            <div class="method-icon"><i class="fa-solid fa-phone"></i></div>
                            <div class="method-text">
                                <h4 style="font-weight: 800;">Telepon Kantor</h4>
                                <p><a href="tel:08161317107">0816-1317-107</a></p>
                                <p><a href="tel:085881994889">0858-8199-4889</a></p>
                            </div>
                        </div>
                        
                        <div class="method-item">
                            <div class="method-icon"><i class="fa-solid fa-envelope"></i></div>
                            <div class="method-text">
                                <h4 style="font-weight: 800;">Alamat Email</h4>
                                <p><a href="mailto:bintangteknikpersada@gmail.com">bintangteknikpersada@gmail.com</a></p>
                                <p><a href="mailto:Sumarmobst@yahoo.com">Sumarmobst@yahoo.com</a></p>
                                <p><a href="mailto:Sulartobst@gmail.com">Sulartobst@gmail.com</a></p>
                            </div>
                        </div>

                        <div class="method-item">
                            <div class="method-icon"><i class="fa-solid fa-clock"></i></div>
                            <div class="method-text">
                                <h4 style="font-weight: 800;">Jam Operasional</h4>
                                <p style="color: #ffffff;">Senin - Jumat: 08:30 - 17:00 WIB<br>Sabtu, Minggu & Hari Libur: Tutup</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="whatsapp-direct-box">
                        <h4 style="font-weight: 800;">Kontak Cepat via WhatsApp</h4>
                        <p style="color: #ffffff;">Hubungi sales engineer kami langsung untuk respon instan di luar jam kantor.</p>
                        <div style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
                            <a href="https://wa.me/628161317107?text=Halo%20PT.%20Bintang%20Surya%20Teknik%20Persada%2C%20saya%20ingin%20meminta%20informasi%20mengenai%20produk%20dan%20ketersediaan." 
                               target="_blank" class="btn btn-whatsapp-large" style="width: 100%;">
                                <i class="fa-brands fa-whatsapp"></i> Chat WhatsApp 1: +62 816-1317-107
                            </a>
                            <a href="https://wa.me/6285881994889?text=Halo%20PT.%20Bintang%20Surya%20Teknik%20Persada%2C%20saya%20ingin%20meminta%20informasi%20mengenai%20produk%20dan%20ketersediaan." 
                               target="_blank" class="btn btn-whatsapp-large" style="width: 100%;">
                                <i class="fa-brands fa-whatsapp"></i> Chat WhatsApp 2: +62 858-8199-4889
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Map Google Embed -->
            <div class="map-section">
                <div class="map-info-overlay">
                    <div class="map-overlay-content">
                        <h4 style="font-weight: 800;">Kunjungi Kantor Kami</h4>
                        <p style="color: #ffffff;">Jl. Abdurahman No.165, RW.8, Parigi Baru, Tangerang Selatan</p>
                        <a href="https://maps.app.goo.gl/ywgkJD4szouAUo9g8" target="_blank" class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-map-pin"></i> Buka di Google Maps
                        </a>
                    </div>
                </div>
                
                <div class="office-map-wrap" id="officeMap">
                    <iframe
                        src="https://maps.google.com/maps?q=Jl.+Abdurahman+No.165,+Parigi+Baru,+Kec.+Pd.+Aren,+Kota+Tangerang+Selatan,+Banten+15228&t=&z=16&ie=UTF8&iwloc=&output=embed"
                        width="100%"
                        height="100%"
                        style="border:0; width:100%; height:100%;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title={`Peta Lokasi Kantor ${siteInfo.companyName}`}
                    ></iframe>
                </div>
                <div class="map-error hidden" id="mapError">
                    <i class="fa-solid fa-map-location-dot"></i>
                    <p>Peta tidak bisa dimuat.</p>
                    <span>Silakan gunakan tombol "Buka di Google Maps" di atas untuk melihat lokasi kami.</span>
                </div>
            </div>
        </div>
    </section>

    <script src="/js/app.js" is:inline></script>
</BaseLayout>