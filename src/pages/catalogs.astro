---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lembar Brosur | PT. Bintang Surya Teknik Persada" activeNav="catalogs">
    <!-- Header Halaman -->
    <section class="page-header">
      <div class="page-header-bg-overlay"></div>
      <div class="container">
        <h1 class="page-header-title">Lembar Brosur Spesifikasi</h1>
        <p class="page-header-subtitle">
          Silakan klik lembar brosur di bawah untuk membuka dan melihat
          spesifikasi detail dalam resolusi tinggi atau untuk mengunduhnya.
        </p>
      </div>
    </section>

    <!-- Section Katalogs Grid -->
    <section class="catalogs" id="catalogs">
      <div class="container">
        <div class="catalog-grid">
          
          <div
            class="catalog-card"
            data-index="0"
            data-src="/assets/images/catalog/ac-motor.png"
          >
            <div class="catalog-thumb">
              <img src="/assets/images/catalog/ac-motor.png" alt="Katalog Elektromotor" />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Elektromotor</h3>
              <p>AC/DC Motor Induksi, Motor Listrik Industri.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="1"
            data-src="/assets/images/catalog/helical-bevel-gearbox.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/images/catalog/helical-bevel-gearbox.png"
                alt="Katalog Helical Gear Motor"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Helical Gear Motor</h3>
              <p>Yuema TR, TRF, TRXF, TKF, TK, TRX Series.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="2"
            data-src="/assets/images/catalog/worm-gearbox.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/images/catalog/worm-gearbox.png"
                alt="Katalog Worm Gear Reducer"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Worm Gear Reducer</h3>
              <p>Chenta WPA, WPS, WPO, WPDA, Motovario NMRV, RV.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="3"
            data-src="/assets/images/catalog/parallel-gearbox-catalog.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/images/catalog/parallel-gearbox-catalog.png"
                alt="Katalog Worm Gear"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Worm Gear</h3>
              <p>ZDY, ZLY, ZSY/ZFY, ZLYJ, BWD/XWD, BLD/XLD Series.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="4"
            data-src="/assets/images/catalog/vibrator-inverter-compressor.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/images/catalog/vibrator-inverter-compressor.png"
                alt="Katalog Inverter"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Inverter</h3>
              <p>ABB, Schneider, Fuji, Delta Inverter Series.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="5"
            data-src="/assets/images/catalog/centrifugal-pump.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/images/catalog/centrifugal-pump.png"
                alt="Katalog Centrifugal Pump"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Centrifugal Pump</h3>
              <p>CNP &amp; Speck Multistage, Side Channel Pump.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="6"
            data-src="/assets/images/catalog/industrial-pump.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/images/catalog/industrial-pump.png"
                alt="Katalog Pompa Celup / Submersible"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Pompa Celup</h3>
              <p>Ebara, Yuema Submersible &amp; Deepwell Pump.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="7"
            data-src="/assets/images/catalog/vibrator-inverter-compressor.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/images/catalog/vibrator-inverter-compressor.png"
                alt="Katalog Vibrator Motor"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Vibrator</h3>
              <p>Ital Vibras Electric Vibrator Motor Series.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="8"
            data-src="/assets/images/catalog/compact-mini-gear-motor.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/images/catalog/compact-mini-gear-motor.png"
                alt="Katalog Pulley"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Pulley</h3>
              <p>V-Belt Pulley, Timing Pulley, Taper Lock Series.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="9"
            data-src="/assets/images/catalog/vibrator-inverter-compressor.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/images/catalog/vibrator-inverter-compressor.png"
                alt="Katalog Air Compressor"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Compressor</h3>
              <p>Puma &amp; United Air Compressor, Piston &amp; Screw Type.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="10"
            data-src="/assets/images/catalog/ac-motor.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/images/catalog/ac-motor.png"
                alt="Katalog Blower"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Blower</h3>
              <p>Ring Blower, Root Blower, Centrifugal Blower Series.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="11"
            data-src="/assets/images/catalog/chain-hoist.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/images/catalog/chain-hoist.png"
                alt="Katalog Chain Hoist"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Chain Hoist</h3>
              <p>HHXG-A, SHH-A, SHH-AM, Hand Lever Block, Manual Trolley.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="12"
            data-src="/assets/images/catalog/gear-pump.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/images/catalog/gear-pump.png"
                alt="Katalog Gear Pump"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Gear Pump</h3>
              <p>Koshin &amp; Yuema GL, GC, GB, KCB, 2CY Series.</p>
            </div>
          </div>

          <div
            class="catalog-card"
            data-index="13"
            data-src="/assets/brand/logo.png"
          >
            <div class="catalog-thumb">
              <img
                src="/assets/brand/logo.png"
                alt="Katalog Genset / Generator"
              />
              <div class="catalog-overlay">
                <i class="fa-solid fa-expand"></i>
                <span>Buka Brosur</span>
              </div>
            </div>
            <div class="catalog-info">
              <h3>Genset</h3>
              <p>Diesel Generator Set, Silent &amp; Open Type Series.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Lightbox Modal Brosur -->
    <div class="lightbox" id="lightbox">
      <button
        class="lightbox-close"
        id="lightboxClose"
        aria-label="Close Lightbox"
      >
        <i class="fa-solid fa-xmark"></i>
      </button>
      <button
        class="lightbox-btn lightbox-prev"
        id="lightboxPrev"
        aria-label="Previous Page"
      >
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button
        class="lightbox-btn lightbox-next"
        id="lightboxNext"
        aria-label="Next Page"
      >
        <i class="fa-solid fa-chevron-right"></i>
      </button>

      <div class="lightbox-content">
        <img src="" alt="Detail Brosur" id="lightboxImg" />
      </div>

      <div class="lightbox-caption">
        <span id="lightboxTitle">Judul Brosur</span>
        <a href="" id="lightboxDownload" download class="btn-download"
          ><i class="fa-solid fa-download"></i> Unduh Lembar Brosur</a
        >
      </div>
    </div>

    <script src="/js/app.js" is:inline></script>
</BaseLayout>
