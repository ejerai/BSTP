---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="PT. Bintang Surya Teknik Persada | Mechanical-Electrical Distributor" activeNav="home">
    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="hero-bg-overlay"></div>
        <div class="hero-container">
            <div class="hero-content">
                <h1 class="hero-title">Penyedia Sistem Pompa Industri Terintegrasi dan Skala Industri</h1>
                <p class="hero-subtitle">PT. Bintang Surya Teknik Persada menyediakan produk Elektromotor, Gearbox, Pompa Transfer, Chain Hoist, Inverter, dan Kompresor Angin berstandar Internasional dengan jaminan kualitas terbaik.</p>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats">
        <div class="stats-container">
            <div class="stat-card">
                <div class="stat-icon"><i class="fa-solid fa-award"></i></div>
                <div class="stat-number" data-target="15">15+</div>
                <div class="stat-label">Tahun Pengalaman</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fa-solid fa-users-gear"></i></div>
                <div class="stat-number" data-target="500">500+</div>
                <div class="stat-label">Klien Industri</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fa-solid fa-circle-check"></i></div>
                <div class="stat-number" data-target="100">100%</div>
                <div class="stat-label">Produk Original</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fa-solid fa-truck-ramp-box"></i></div>
                <div class="stat-number" data-target="50">50+</div>
                <div class="stat-label">Brand Internasional</div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="about" id="about">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Profil <br> PT. Bintang Surya Teknik Persada</h2>
                <div class="section-line"></div>
            </div>
            
            <div class="about-content">
                <h3>Mitra Mechanical & Electrical Terpercaya Anda</h3>
                <p>PT Bintang Surya Teknik Persada merupakan salah satu perusahaan yang bergerak dalam bidang general supplier untuk industri dengan berbagai macam produk yang kami tawarkan, mulai dari Single & three phase induktion motor, Vibrator motor, Worm gear, Worm gearbox, Compact gear motor, Helical & bevel gearbox, Pararel gearbox, AC induktion motor, Centrifugal pump, Gear pump, dll.</p>
                <div class="about-pillars" style="margin-bottom: 30px;">
                    <div class="pillar-item">
                        <div class="pillar-icon"><i class="fa-solid fa-shield-halved"></i></div>
                        <div class="pillar-text">
                            <h4>Jaminan Kualitas</h4>
                            <p>Semua produk yang kami jual 100% asli dan baru dengan garansi pabrik resmi.</p>
                        </div>
                    </div>
                    <div class="pillar-item">
                        <div class="pillar-icon"><i class="fa-solid fa-gauge-high"></i></div>
                        <div class="pillar-text">
                            <h4>Respon Cepat</h4>
                            <p>Tim sales engineer kami siap menanggapi permintaan penawaran harga dan konsultasi Anda secara cepat.</p>
                        </div>
                    </div>
                </div>

                <a href="/about" class="btn btn-primary">
                    <i class="fa-solid fa-circle-info"></i> Baca Selengkapnya
                </a>
            </div>
        </div>
    </section>

    <!-- Brand Terpopuler -->
    <section class="brands" id="brands">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Brand Terpopuler</h2>
                <div class="section-line"></div>
                <p class="section-subtitle">PT. Bintang Surya Teknik Persada sebagai partner dan distributor resmi dari berbagai merek ternama. Kami menyediakan berbagai kebutuhan untuk proyek anda.</p>
            </div>
            
            <div class="brands-grid">
                <div class="brand-item">
                    <img src="/assets/images/brands/abb-logo.png" alt="ABB" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/cnp-logo.png" alt="CNP" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/hitachi-logo.png" alt="Hitachi" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/koshin-logo.png" alt="Koshin" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/liming-logo.png" alt="Liming" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/motovario-logo.png" alt="Motovario" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/puma-logo.png" alt="Puma" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/schneider-logo.png" alt="Schneider Electric" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/innomotics-logo.png" alt="Innomotics" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/speck-pumpen-logo.png" alt="Speck Pumpen" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/teco-logo.png" alt="Teco" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/yuema-logo.png" alt="Yuema" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/revco-logo.png" alt="Revco" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/bologna-logo.png" alt="Bologna" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/alliance-logo.png" alt="Alliance" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/chenta-logo.png" alt="Chenta" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/guomao-logo.png" alt="Guomao" loading="lazy">
                </div>
                <div class="brand-item">
                    <img src="/assets/images/brands/transmax-logo.png" alt="Transmax" loading="lazy">
                </div>
            </div>
        </div>
    </section>

    <!-- Produk Utama -->
    <section class="products" id="products" style="background-color: var(--bg-light);">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Solusi Komponen Industri Kami</h2>
                <div class="section-line"></div>
                <p class="section-subtitle">BSTP menyediakan jajaran produk mekanikal & elektrikal berkualitas tinggi dari brand terkemuka dunia.</p>
            </div>
            
            <div class="catalog-grid" style="margin-bottom: 40px;">
                <div class="catalog-card" onclick="window.location.href='/products'">
                    <div class="catalog-thumb" style="background-color: #fff;">
                        <img src="/assets/images/catalog/elektromotor1.webp" alt="Elektromotor">
                        <div class="catalog-overlay">
                            <i class="fa-solid fa-arrow-right"></i>
                            <span>Buka Etalase</span>
                        </div>
                    </div>
                    <div class="catalog-info" style="text-align: center;">
                        <h3>Elektromotor</h3>
                        <p>AC/DC Induction Motor & Vibrator Motor</p>
                    </div>
                </div>

                <div class="catalog-card" onclick="window.location.href='/products'">
                    <div class="catalog-thumb" style="background-color: #fff;">
                        <img src="/assets/images/catalog/wormgear1.webp" alt="Gearbox & Gearmotor">
                        <div class="catalog-overlay">
                            <i class="fa-solid fa-arrow-right"></i>
                            <span>Buka Etalase</span>
                        </div>
                    </div>
                    <div class="catalog-info" style="text-align: center;">
                        <h3>Gearbox & Gearmotor</h3>
                        <p>Helical, Bevel, Worm Gearbox & Variator</p>
                    </div>
                </div>

                <div class="catalog-card" onclick="window.location.href='/products'">
                    <div class="catalog-thumb" style="background-color: #fff;">
                        <img src="/assets/images/catalog/centrifugalpump2.webp" alt="Pompa Industri & CNP">
                        <div class="catalog-overlay">
                            <i class="fa-solid fa-arrow-right"></i>
                            <span>Buka Etalase</span>
                        </div>
                    </div>
                    <div class="catalog-info" style="text-align: center;">
                        <h3>Pompa Industri</h3>
                        <p>Centrifugal, Submersible, Hydrant & Gear Pump</p>
                    </div>
                </div>
            </div>

            <div style="text-align: center;">
                <a href="/products?category=all" class="btn btn-primary">
                    <i class="fa-solid fa-boxes-stacked"></i> Lihat Semua Produk Lengkap
                </a>
            </div>
        </div>
    </section>

    <!-- Katalog Section -->
    <section class="katalog" id="katalog">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Lihat Katalog & Profil Perusahaan Kami</h2>
                <div class="section-line"></div>
                <p class="section-subtitle">Pelajari lebih lengkap kapabilitas, jajaran produk, dan layanan BSTP melalui dokumen company profile resmi kami.</p>
            </div>

            <div class="katalog-preview">
                <div class="about-image-wrapper" id="aboutImageTrigger">
                    <img src="/assets/brand/logo.png" alt="Logo PT. Bintang Surya Teknik Persada" class="about-img">
                    <div class="about-experience-badge">
                        <span class="years">BSTP</span>
                        <span class="text">Lihat PDF</span>
                    </div>
                    <div class="about-image-overlay">
                        <i class="fa-solid fa-file-pdf"></i>
                        <span>Lihat Company Profile (PDF)</span>
                    </div>
                </div>

                <div class="katalog-preview-cta">
                    <a href="/assets/KATALOG.pdf" target="_blank" class="btn btn-primary">
                        <i class="fa-solid fa-file-pdf"></i> Buka Company Profile (PDF)
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact" id="contact" style="background-color: var(--bg-light);">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Ada Pertanyaan atau Butuh Quotation?</h2>
                <div class="section-line"></div>
                <p class="section-subtitle">Tim support kami siap membantu memberikan solusi teknis terbaik dan penawaran harga bersaing.</p>
            </div>
            
            <div class="contact-grid" style="margin-bottom: 0; display: flex; justify-content: center;">
                <div class="contact-info-panel" style="max-width: 600px; width: 100%;">
                    <h3>Hubungi Sales Engineer Kami</h3>
                    <p class="panel-desc"></p>
                    <div class="contact-methods" style="margin-bottom: 30px;">
                        <div class="method-item">
                            <div class="method-icon"><i class="fa-solid fa-phone"></i></div>
                            <div class="method-text">
                                <h4>Telepon Kantor</h4>
                                <p><a href="tel:08161317107" style="color: #ffffff;">0816-1317-107</a> / <a href="tel:085881994889" style="color: #ffffff;">0858-8199-4889</a></p>
                            </div>
                        </div>
                        <div class="method-item">
                            <div class="method-icon"><i class="fa-solid fa-envelope"></i></div>
                            <div class="method-text">
                                <h4>Alamat Email</h4>
                                <p><a href="mailto:bintangteknikpersada@gmail.com" style="color: #ffffff;">bintangteknikpersada@gmail.com</a><br><a href="mailto:Sumarmobst@yahoo.com" style="color: #ffffff;">Sumarmobst@yahoo.com</a><br><a href="mailto:Sulartobst@gmail.com" style="color: #ffffff;">Sulartobst@gmail.com</a></p>
                            </div>
                        </div>
                    </div>
                    
                    <div style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
                        <a href="https://wa.me/628161317107?text=Halo%20PT.%20Bintang%20Surya%20Teknik%20Persada%2C%20saya%20ingin%20meminta%20informasi%20mengenai%20produk%20dan%20ketersediaan." 
                           target="_blank" class="btn btn-whatsapp-large" style="width: 100%;">
                            <i class="fa-brands fa-whatsapp"></i> Chat WhatsApp 1: +62 816-1317-107
                        </a>
                        <a href="https://wa.me/6285881994889?text=Halo%20PT.%20Bintang%20Surya%20Teknik%20Persada%2C%20saya%20ingin%20meminta%20informasi%20mengenai%20produk%20dan%20ketersediaan." 
                           target="_blank" class="btn btn-whatsapp-large" style="width: 100%;">
                            <i class="fa-brands fa-whatsapp"></i> Chat WhatsApp 2: +62 858-8199-4889
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- PDF Modal -->
    <div class="modal" id="pdfProfileModal">
        <div class="modal-content pdf-modal-content">
            <button class="modal-close" id="pdfModalClose" aria-label="Close Modal"><i class="fa-solid fa-xmark"></i></button>
            <div class="pdf-modal-header">
                <div>
                    <h3>Company Profile PT. Bintang Surya Teknik Persada</h3>
                    <p>Lihat langsung atau unduh dokumen profil perusahaan kami.</p>
                </div>
                <div class="pdf-modal-actions">
                    <a href="/assets/KATALOG.pdf" target="_blank" class="btn btn-primary">
                        <i class="fa-solid fa-up-right-from-square"></i> Buka Tab Baru
                    </a>
                    <a href="/assets/KATALOG.pdf" download class="btn btn-download">
                        <i class="fa-solid fa-download"></i> Unduh
                    </a>
                </div>
            </div>
            <iframe class="pdf-viewer-frame" id="pdfViewerFrame" title="Company Profile BSTP"></iframe>
        </div>
    </div>

    <!-- Client-side script for PDF Modal & Scroll Reveal original behavior -->
    <script src="/js/app.js" is:inline></script>
</BaseLayout>
