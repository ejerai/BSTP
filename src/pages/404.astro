---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteInfo } from '../data/siteInfo';
---

<BaseLayout title={`Halaman Tidak Ditemukan | ${siteInfo.companyName}`} hideChrome={true} noindex={true}>
  <section class="error-404-section">
    <div class="error-404-bg-overlay"></div>

    <div class="error-404-container">
      <div class="error-404-badge">
        <i class="fa-solid fa-plug-circle-xmark"></i>
      </div>

      <h1 class="error-404-code">404</h1>
      <h2 class="error-404-title">Halaman Tidak Ditemukan</h2>
      <p class="error-404-desc">
        Maaf, halaman yang Anda cari tidak tersedia, sudah dipindahkan, atau alamat URL yang dimasukkan kurang tepat.
      </p>

      <div class="error-404-actions">
        <a href="/" class="btn btn-primary btn-lg">
          <i class="fa-solid fa-house"></i>
          <span>Kembali ke Beranda</span>
        </a>
        <a href="/products" class="btn btn-outline btn-lg">
          <i class="fa-solid fa-box-open"></i>
          <span>Lihat Produk</span>
        </a>
      </div>

      <div class="error-404-quicklinks">
        <a href="/about"><i class="fa-solid fa-circle-info"></i>Tentang Kami</a>
        <a href="/catalogs"><i class="fa-solid fa-book"></i>Katalog</a>
        <a href="/contact"><i class="fa-solid fa-envelope"></i>Kontak</a>
      </div>
    </div>
  </section>
</BaseLayout>